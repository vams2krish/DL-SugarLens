{
  "name": "dl-sugarlens",
  "version": "1.1.0",
  "description": "Deep learning web and mobile PWA for on-device produce recognition and USDA reference sugar estimates",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node scripts/verify.mjs",
    "native:android": "npm run build && node scripts/native.mjs android",
    "native:ios": "npm run build && node scripts/native.mjs ios"
  },
  "keywords": [],
  "author": "Vamshi Krishna Adam",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow-models/mobilenet": "2.1.1",
    "@tensorflow/tfjs": "4.22.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "vite": "^6.4.5"
  }
}
